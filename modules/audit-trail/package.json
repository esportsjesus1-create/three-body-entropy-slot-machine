{
  "name": "@three-body-entropy/audit-trail",
  "version": "1.0.0",
  "description": "Comprehensive audit logging system for tracking all critical game events for compliance and dispute resolution",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:perf": "jest --testPathPattern=performance",
    "lint": "eslint src/**/*.ts tests/**/*.ts",
    "prepublishOnly": "npm run build",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=prisma/schema.prisma"
  },
  "keywords": [
    "audit-trail",
    "logging",
    "compliance",
    "gaming",
    "provably-fair",
    "prisma"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@prisma/client": "^5.0.0"
  },
  "peerDependencies": {
    "@prisma/client": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@prisma/client": {
      "optional": true
    }
  }
}
